@prefix bao:  <https://w3id.org/boolean-algebra-ontology#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh:   <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .



####################################################################################################################################################################################
# Classes and Properties
####################################################################################################################################################################################

bao:True rdf:type rdfs:Class.
bao:False rdf:type rdfs:Class.

bao:is-in-contradiction-with rdf:type rdf:Property.

bao:Disjunction rdf:type rdfs:Class.
bao:has-disjunct rdf:type rdf:Property.


####################################################################################################################################################################################
# SHACL Shapes
####################################################################################################################################################################################

bao:EmbeddedPrefixes sh:declare 
	[sh:prefix"rdf";sh:namespace"http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI],
	[sh:prefix"rdfs";sh:namespace"http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI],
	[sh:prefix"bao";sh:namespace"https://w3id.org/boolean-algebra-ontology#"^^xsd:anyURI].


# Every instance of bao:True and bao:False must be a reified statement, i.e., an instance of rdf:Statement, and must specify the three reification properties: rdf:subject, rdf:predicate, and rdf:object.
[rdf:type sh:NodeShape;
    sh:targetClass bao:True; sh:targetClass bao:False;
    sh:class rdf:Statement;
    sh:property [sh:path rdf:subject; sh:minCount 1; sh:maxCount 1];
    sh:property [sh:path rdf:predicate; sh:minCount 1; sh:maxCount 1];
    sh:property [sh:path rdf:object; sh:minCount 1; sh:maxCount 1]].


# The following shapes validate the bao:is-in-contradiction-with property, which can only hold between different reifications of the same underlying triple, where one is asserted as bao:True and the other as bao:False.
[rdf:type sh:NodeShape ;
    sh:targetSubjectsOf bao:is-in-contradiction-with ;
    sh:sparql[sh:prefixes bao:EmbeddedPrefixes; rdf:type sh:SPARQLConstraint ;
        sh:message "The subject and object of 'bao:is-in-contradiction-with' must be two nested triples referring to the same underlying RDF triple, differing only in their outer truth value: exactly one must be bao:True and the other bao:False.";
		sh:select """SELECT $this ?other
					 WHERE 
					 {
						$this bao:is-in-contradiction-with ?other.
						FILTER(NOT EXISTS{$this rdf:type rdf:Statement; rdf:subject ?sThis; rdf:predicate rdf:type; rdf:object ?oThis. 
										  ?other rdf:type rdf:Statement; rdf:subject ?sOther; rdf:predicate rdf:type; rdf:object ?oOther.
										  ?sThis rdf:subject ?s; rdf:predicate ?p; rdf:object ?o. 
										  ?sOther rdf:subject ?s; rdf:predicate ?p; rdf:object ?o.
										  FILTER(((?oThis=bao:True)&&(?oOther=bao:False))||((?oThis=bao:False)&&(?oOther=bao:True)))})
					 }"""]].


# The following shape validates the bao:has-disjunct property, which may only relate instances of bao:Disjunction to the reification of triples asserting that the reification of another triple is an instance of either bao:True or bao:False.
[rdf:type sh:NodeShape ;
    sh:targetSubjectsOf bao:has-disjunct ;
    sh:sparql[sh:prefixes bao:EmbeddedPrefixes; rdf:type sh:SPARQLConstraint ;
        sh:message "The subject and object of 'bao:has-disjunct' must respectively be an instance of bao:Disjunction and the reification of triples asserting that the reification of another triple is an instance of either bao:True or bao:False.";
		sh:select """SELECT $this
					 WHERE 
					 {
						$this bao:has-disjunct ?d.
						FILTER(NOT EXISTS{$this rdf:type bao:Disjunction.
										  ?d rdf:type rdf:Statement; rdf:subject ?sd; rdf:predicate rdf:type; rdf:object ?od.
										  ?sd rdf:type rdf:Statement; rdf:subject ?s; rdf:predicate ?p; rdf:object ?o.
										  FILTER((?od=bao:True)||(?od=bao:False))})
					 }"""]].


# This shape invalidates instances of the class bao:Disjunction that are linked to less than two disjuncts via the property bao:has-disjunct.
# Disjunctions with zero or one disjunct are nevertheless permitted during inference, but are removed before the inferred graph is validated again.
[rdf:type sh:NodeShape;
    sh:targetClass bao:Disjunction;
    sh:property[sh:path bao:has-disjunct; sh:minCount 2; sh:message "Invalid disjunction: every instance of bao:Disjunction must have at least two disjuncts."]].

# The properties bao:entails-disjunction and bao:add-all-disjuncts-but are also temporary and must be removed before validating the inferred graph.
[rdf:type sh:NodeShape;
    sh:targetSubjectsOf bao:entails-disjunction;
    sh:sparql[sh:prefixes bao:EmbeddedPrefixes; rdf:type sh:SPARQLConstraint;
		sh:message "Invalid graph: bao:entails-disjunction is reserved for temporary triples used during inference and must not occur in the knowledge graph.";
        sh:select """SELECT $this WHERE{$this bao:entails-disjunction ?o}"""]].
[rdf:type sh:NodeShape;
    sh:targetSubjectsOf bao:add-all-disjuncts-but;
    sh:sparql[sh:prefixes bao:EmbeddedPrefixes; rdf:type sh:SPARQLConstraint;
		sh:message "Invalid graph: bao:add-all-disjuncts-but is reserved for temporary triples used during inference and must not occur in the knowledge graph.";
        sh:select """SELECT $this WHERE{$this bao:add-all-disjuncts-but ?o}"""]].


####################################################################################################################################################################################
# SHACL-SPARQL Rules
####################################################################################################################################################################################

# If the reification of a triple is asserted as an instance of bao:True, then the corresponding triple can be added to the graph.
[rdf:type sh:NodeShape;
	sh:targetNode bao:True;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{?s ?p ?o}WHERE{<<?s ?p ?o>> rdf:type $this}"""]].


# If the reification of a triple is asserted as false and this reification itself corresponds to an embedded true/false assertion, 
# the embedded triple with the opposite truth value is added to the knowledge graph (double negation).
[rdf:type sh:NodeShape;
	sh:targetNode bao:False;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{?s rdf:type ?rtv}
						WHERE{<<?s rdf:type ?o>> rdf:type $this.
							  OPTIONAL{FILTER(?o=bao:True) BIND(bao:False AS ?rtv)} OPTIONAL{FILTER(?o=bao:False) BIND(bao:True AS ?rtv)} FILTER(BOUND(?rtv))}"""]].


# If a triple is asserted as both true and false, a contradiction is inferred: the fact that the triple is true contradicts the fact that it is false.
[rdf:type sh:NodeShape;
	sh:targetNode bao:False;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{<< <<?s ?p ?o>> rdf:type bao:True>> bao:is-in-contradiction-with << <<?s ?p ?o>> rdf:type bao:False>>}
						WHERE{<<?s ?p ?o>> rdf:type $this. ?s ?p ?o}"""]].


# bao:is-in-contradiction-with is a symmetric property
[rdf:type sh:NodeShape;
	sh:targetNode bao:is-in-contradiction-with;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{?o $this ?s}WHERE{?s $this ?o}"""]].


# If an instance of bao:Disjunction has a single disjunct, then that disjunct is asserted in the knowledge graph.
[rdf:type sh:NodeShape;
	sh:targetClass bao:Disjunction;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{<<?s ?p ?o>> rdf:type ?v}
						WHERE{$this bao:has-disjunct ?d. NOT EXISTS{$this bao:has-disjunct ?d1. FILTER(?d1!=?d)}
							  $this bao:has-disjunct << <<?s ?p ?o>> rdf:type ?v>>}"""]].


# This and the next rule implement Unit Propagation: if the complement of a disjunct of a bao:Disjunction occurs in the knowledge graph, a new entailing disjunction is created 
# (only once!). The new disjunction is also linked to the disjunct whose complement occurs in the graph via the special property bao:add-all-disjuncts-but, signalling to the
# subsequent rules that all disjuncts of the entailed disjunction, except this one, must be copied to the entailing disjunction.
[rdf:type sh:NodeShape;
	sh:targetClass bao:Disjunction;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{[rdf:type bao:Disjunction] bao:entails-disjunction $this; bao:add-all-disjuncts-but <<<<?s ?p ?o>> rdf:type ?v>>}
						WHERE{$this bao:has-disjunct << <<?s ?p ?o>> rdf:type ?v>>.
							  FILTER( ((?v=bao:True)&&EXISTS{<<?s ?p ?o>> rdf:type bao:False}) || ((?v=bao:False)&&EXISTS{?s ?p ?o}) )
							  NOT EXISTS{[rdf:type bao:Disjunction] bao:entails-disjunction $this}}"""]].

# Together with the previous rule, this rule implements Unit Propagation: if the previous rule created a disjunction that entails another and linked the former to a disjunct 
# of the latter via bao:add-all-disjuncts-but, all disjuncts of the latter, except this one, must be copied to the former.
[rdf:type sh:NodeShape;
	sh:targetClass bao:Disjunction;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{?d bao:has-disjunct ?dsj2}
						WHERE{?d bao:entails-disjunction $this. ?d bao:add-all-disjuncts-but ?dsj.
							  $this bao:has-disjunct ?dsj2. FILTER(?dsj!=?dsj2)}"""]].

# This rule implements Absorption: if a disjunct of a bao:Disjunction occurs in the knowledge graph, a new entailing disjunction is created (only once!). 
# Unlike Unit Propagation, however, this disjunction must remain empty, so the property bao:add-all-disjuncts-but is not added.
[rdf:type sh:NodeShape;
	sh:targetClass bao:Disjunction;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{[rdf:type bao:Disjunction] bao:entails-disjunction $this}
						WHERE{$this bao:has-disjunct << <<?s ?p ?o>> rdf:type ?v>>. 
							  FILTER( ((?v=bao:True)&&EXISTS{?s ?p ?o}) || ((?v=bao:False)&&EXISTS{<<?s ?p ?o>> rdf:type bao:False}) )
    						  NOT EXISTS{[rdf:type bao:Disjunction] bao:entails-disjunction $this}}"""]].


# This rule implements Tautology Elimination: if a bao:Disjunction contains both a disjunct and its negation, a new entailing disjunction is created (only once!)
# As for Absorption, there is no need to add the property bao:add-disjuncts-from in this case, as no disjuncts need to be copied from one disjunction to the other.
[rdf:type sh:NodeShape;
	sh:targetClass bao:Disjunction;
	sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
		sh:construct """CONSTRUCT{[rdf:type bao:Disjunction] bao:entails-disjunction $this}
						WHERE{$this bao:has-disjunct <<?dsj rdf:type ?v>>.
							  $this bao:has-disjunct <<?dsj rdf:type ?vn>>. FILTER(STR(?vn)<STR(?v))
							  NOT EXISTS{[rdf:type bao:Disjunction] bao:entails-disjunction $this}}"""]].


# If the graph contains two disjunctions such that one has a *proper* subset of the other's disjuncts, it is inferred that the former entails the latter.
# The next rule handles the special case where two disjunctions have the *same* set of disjuncts.
# NB: This rule only applies to disjunctions with at least two disjuncts. The rules above may infer temporary disjunctions with zero or one disjunct. Thus, without 
# this restriction, the rule below would infer that every disjunction with zero disjuncts bao:entails-disjunction any other disjunction, causing the latter to be removed.
[rdf:type sh:NodeShape;
    sh:targetClass bao:Disjunction;
    sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
        sh:construct """CONSTRUCT{$this bao:entails-disjunction ?de}
            WHERE{$this rdf:type bao:Disjunction. ?de rdf:type bao:Disjunction.
                EXISTS{$this bao:has-disjunct ?dsj1. $this bao:has-disjunct ?dsj2. FILTER(?dsj1!=?dsj2)}
				NOT EXISTS{$this bao:has-disjunct ?dsj1. NOT EXISTS{?de bao:has-disjunct ?dsj1}}
				EXISTS{?de bao:has-disjunct ?dsje. NOT EXISTS{$this bao:has-disjunct ?dsje}}}"""]].

# This rule is similar to the previous one, but only applies to disjunctions with the *same* set of disjuncts. Such disjunctions entail one another, but asserting both
# entailments would cause both to be removed. Since one must be preserved, we assert bao:entails-disjunction only from the lexicographically lower disjunction to the other.
[rdf:type sh:NodeShape;
    sh:targetClass bao:Disjunction;
    sh:rule[rdf:type sh:SPARQLRule; sh:prefixes bao:EmbeddedPrefixes;
        sh:construct """CONSTRUCT{$this bao:entails-disjunction ?de}
            WHERE{$this rdf:type bao:Disjunction. ?de rdf:type bao:Disjunction.
                EXISTS{$this bao:has-disjunct ?dsj1. $this bao:has-disjunct ?dsj2. FILTER(?dsj1!=?dsj2)}
				NOT EXISTS{$this bao:has-disjunct ?dsj1. NOT EXISTS{?de bao:has-disjunct ?dsj1}}
				NOT EXISTS{?de bao:has-disjunct ?dsje. NOT EXISTS{$this bao:has-disjunct ?dsje}}
				FILTER(STR($this)<STR(?de))}"""]].

 
